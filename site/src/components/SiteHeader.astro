---
const base = import.meta.env.BASE_URL; // '/warden/'
const gh = 'https://github.com/srjn45/warden';
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={base} aria-label="warden home">
      <svg class="brand-mark" viewBox="0 0 240 240" width="22" height="22" fill="none" aria-hidden="true">
        <g stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
          <polygon points="120,20 206.6,70 206.6,170 120,220 33.4,170 33.4,70" stroke-width="13"/>
          <polyline points="74,86 96,154 120,116 144,154 166,86" stroke-width="13"/>
        </g>
      </svg>
      <span>warden</span>
    </a>
    <div class="nav-links">
      <a class="hide-sm" href="#features">Features</a>
      <a class="hide-sm" href="#pipeline">How it works</a>
      <a href={`${base}start/what-is-warden/`}>Docs</a>
      <a href={`${base}blog/`}>Blog</a>
      <a class="hide-sm" href={gh}>GitHub</a>
      <a class="nav-cta" href={`${base}start/install/`}>Install</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    backdrop-filter: blur(10px);
    background: rgba(13, 17, 23, 0.72);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; gap: 20px; height: 58px; }
  .brand {
    display: flex; align-items: center; gap: 9px;
    font-weight: 700; color: var(--fg); font-size: 1.05rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    text-decoration: none;
  }
  .brand-mark { color: var(--accent); flex: none; }
  .nav-links { margin-left: auto; display: flex; gap: 22px; align-items: center; }
  .nav-links a { color: var(--muted); font-size: 0.92rem; text-decoration: none; }
  .nav-links a:hover { color: var(--fg); }
  .nav-cta {
    background: var(--accent); color: #06210f !important; font-weight: 700;
    padding: 7px 14px; border-radius: 7px;
  }
  .nav-cta:hover { color: #06210f !important; }
  @media (max-width: 720px) { .nav-links .hide-sm { display: none; } }
</style>
