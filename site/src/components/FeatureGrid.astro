---
import { featureGroups } from '../data/features';
const base = import.meta.env.BASE_URL;
---
<section class="section" id="features">
  <div class="wrap">
    <h2 class="section-title">Everything warden does</h2>
    {featureGroups.map((g) => (
      <div class="fg" id={g.id}>
        <h3 class="fg-title">{g.title}</h3>
        <p class="fg-blurb">{g.blurb}</p>
        <div class="fg-grid">
          {g.features.map((f) => (
            <a class="fg-card" href={`${base}${f.href}/`}>
              <strong>{f.title}</strong>
              <span>{f.desc}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
