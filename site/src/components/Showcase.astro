---
const { side = 'left', title = '', img = '', blurb = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const layoutClass = side === 'right' ? 'showcase-row showcase-row-reverse' : 'showcase-row';
---
{img ? (
  <section class="section">
    <div class={`wrap ${layoutClass}`}>
      <img class="showcase-image" src={`${base}media/${img}`} alt={title} />
      <div class="showcase-copy"><h2>{title}</h2><p>{blurb}</p></div>
    </div>
  </section>
) : (
  <section class="section">
    <div class="wrap showcase-text-only">
      <h2>{title}</h2>
      <p>{blurb}</p>
    </div>
  </section>
)}
