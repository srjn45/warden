---
// Claims map to docs/FEATURES.md §34 (34.1 plan file, 34.2 topology, 34.7 land,
// 34.8 integration branch) and the `wd plan` / `wd autopilot land` CLI.
const steps = [
  {
    n: '1',
    title: 'Plan',
    cmd: 'wd plan run <id> --mode autopilot',
    body: 'Write the goal (and optional constraints and tasks) as a plan. If the task list is empty, the manager breaks the goal down for you.',
  },
  {
    n: '2',
    title: 'Run',
    cmd: 'wd plan pause <id>',
    body: 'A manager delegates tasks to worker agents, each in its own isolated git worktree. Watch and steer them from the TUI or web cockpit, and pause any time.',
  },
  {
    n: '3',
    title: 'Land',
    cmd: 'wd autopilot land <branch>',
    body: 'Each worker PR is gated by CI or your local .warden/check.yml checks, then merged into a per-plan integration branch. Nothing is auto-merged to main — you review and fast-forward it.',
  },
];
---
<section class="section" id="how-it-works">
  <div class="wrap">
    <h2 class="hiw-title">How it works</h2>
    <p class="hiw-lead">Plan → Run → Land. The loop Autopilot drives for you.</p>
    <ol class="hiw-steps">
      {steps.map((s) => (
        <li class="tile hiw-step">
          <span class="hiw-num" aria-hidden="true">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <code class="hiw-cmd">{s.cmd}</code>
        </li>
      ))}
    </ol>
  </div>
</section>
