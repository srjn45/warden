---
const base = import.meta.env.BASE_URL;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/srjn45/warden/main/scripts/install.sh | bash';
const backends = [
  { id: 'claude', label: 'Claude', mark: 'claude.svg' },
  { id: 'codex', label: 'Codex' },
  { id: 'antigravity', label: 'Antigravity' },
  { id: 'cursor', label: 'Cursor' },
  { id: 'opencode', label: 'OpenCode' },
  { id: 'aider', label: 'Aider' },
  { id: 'crush', label: 'Crush' },
  { id: 'goose', label: 'Goose' },
];
---
<section class="section hero">
  <div class="wrap">
    <h1 class="hero-title">Plan it. Autopilot ships it.</h1>
    <p class="hero-sub">Write the goal as a plan. Warden's Autopilot breaks it into tasks, runs worker agents in isolated worktrees, gates each PR through CI, and lands it on an integration branch. Watch and steer the whole fleet from one cockpit, across the AI coding CLIs warden supports.</p>
    <p class="hero-cta">
      <a class="btn btn-primary" href={`${base}start/what-is-warden/`}>Get started</a>
      <a class="btn btn-secondary" href="https://github.com/srjn45/warden">★ View on GitHub</a>
    </p>
    <div class="install">
      <code class="install-cmd mono" id="install-cmd">{installCmd}</code>
      <button type="button" class="copy-btn" id="copy-install" data-cmd={installCmd}>Copy</button>
    </div>
    <p class="hero-note">Needs only curl. See <a href={`${base}start/install/`}>install options</a>.</p>
    <ul class="backend-strip" aria-label="Supported agent backends">
      {backends.map((backend) => (
        <li>
          {backend.mark ? (
            <img class="backend-mark" src={`${base}brand/${backend.mark}`} alt="" aria-hidden="true" />
          ) : <span class="backend-letter" aria-hidden="true">{backend.label.charAt(0)}</span>}
          {backend.label}
        </li>
      ))}
    </ul>
    <img class="hero-media" src={`${base}media/hero.gif`} alt="warden start and warden ls in a terminal" loading="eager" />
  </div>
</section>
<script>
  const btn = document.getElementById('copy-install');
  btn?.addEventListener('click', async () => {
    const cmd = btn.getAttribute('data-cmd') ?? '';
    try {
      await navigator.clipboard.writeText(cmd);
      btn.textContent = 'Copied';
    } catch {
      const sel = window.getSelection();
      const range = document.createRange();
      const el = document.getElementById('install-cmd');
      if (el && sel) { range.selectNodeContents(el); sel.removeAllRanges(); sel.addRange(range); }
      btn.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>
