---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL; // '/warden/'

// Auto-list the newest blog posts (docs entries under blog/ that carry a date).
// New posts appear here automatically — no edits to the landing page needed.
const posts = (await getCollection('docs', (e) => e.id.startsWith('blog/') && e.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section class="section">
  <div class="wrap">
    <div class="blog-head">
      <h2 style="margin:0">From the blog</h2>
      <a href={`${base}blog/`}>Read the blog&nbsp;→</a>
    </div>
    <div class="blog-grid">
      {posts.map((post) => (
        <a class="blog-card" href={`${base}${post.id}/`}>
          <div class="blog-meta">
            <time>{fmtDate(post.data.date)}</time>
            {post.data.tags?.slice(0, 3).map((t) => <span class="blog-tag">{t}</span>)}
          </div>
          <h3 class="blog-title">{post.data.title}</h3>
          <p class="blog-blurb">{post.data.excerpt ?? post.data.description}</p>
          <span class="blog-more">Read post&nbsp;→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 18px;
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .blog-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .blog-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .blog-tag {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 9px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
    color: var(--muted);
  }
  .blog-title {
    margin: 12px 0 8px;
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .blog-blurb {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .blog-more {
    color: var(--link);
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
