---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL; // '/warden/'

// Auto-list the newest blog posts (docs entries under blog/ that carry a date).
// New posts appear here automatically — no edits to the landing page needed.
const posts = (await getCollection('docs', (e) => e.id.startsWith('blog/') && e.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section class="section">
  <div class="wrap">
    <div class="blog-head">
      <h2 class="blog-h2">From the blog</h2>
      <a href={`${base}blog/`}>Read the blog&nbsp;→</a>
    </div>
    <div class="blog-grid">
      {posts.map((post) => (
        <a class="blog-card" href={`${base}${post.id}/`}>
          <div class="blog-meta">
            <time>{fmtDate(post.data.date)}</time>
            {post.data.tags?.slice(0, 3).map((t) => <span class="blog-tag">{t}</span>)}
          </div>
          <h3 class="blog-title">{post.data.title}</h3>
          <p class="blog-blurb">{post.data.excerpt ?? post.data.description}</p>
          <span class="blog-more">Read post&nbsp;→</span>
        </a>
      ))}
    </div>
  </div>
</section>
