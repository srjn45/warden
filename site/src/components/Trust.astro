---
// Claims map to docs/FEATURES.md §13 (bearer-token auth, loopback default),
// workspace-trust prompts, README ("no telemetry, no SaaS"), and LICENSE (Apache-2.0).
const points = [
  { title: 'Loopback by default', body: 'The daemon listens on 127.0.0.1:8765. Nothing is exposed to your network unless you bind it.' },
  { title: 'Token-gated remote access', body: 'Binding a non-loopback address is refused unless a bearer token is set. An optional read-only token gives view-only access.' },
  { title: 'Trust prompts handled', body: 'The one-time "trust this folder?" prompt is answered for each agent (trust_workspace, on by default) and recorded as an event; turn it off to review each in the approvals inbox.' },
  { title: 'No warden telemetry', body: 'Warden keeps its own state locally and has no SaaS telemetry. Your selected AI CLI still contacts its provider; webhooks, Slack alerts and remote access send data only where you configure them.' },
  { title: 'Apache-2.0', body: 'Open source under the Apache License 2.0. Self-host it on a laptop or a box.' },
];
---
<section class="section" id="trust">
  <div class="wrap">
    <h2 class="trust-title">Local-first and trustworthy</h2>
    <ul class="trust-grid">
      {points.map((p) => (
        <li class="tile">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
