---
import '../styles/landing.css';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import Showcase from '../components/Showcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Trust from '../components/Trust.astro';
import PipelineDiagram from '../components/PipelineDiagram.astro';
import Quickstart from '../components/Quickstart.astro';
import AndroidApp from '../components/AndroidApp.astro';
import Blog from '../components/Blog.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL; // '/warden/'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>warden — Plan it. Autopilot ships it.</title>
    <meta name="description" content="Write the goal as a plan. Warden's Autopilot breaks it into tasks, runs worker agents in isolated worktrees, gates each PR through CI, and lands it. One cockpit for Claude, Codex, Antigravity, Cursor, OpenCode, Aider, Crush, and Goose." />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:title" content="warden — Plan it. Autopilot ships it." />
    <meta property="og:description" content="Autopilot turns a plan into CI-gated PRs from worker agents in isolated worktrees, and one cockpit lets you watch and steer every coding agent." />
    <meta property="og:site_name" content="warden" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="warden: Plan it. Autopilot ships it." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://srjn45.github.io/warden/" />
    <meta property="og:image" content="https://srjn45.github.io/warden/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="warden — Plan it. Autopilot ships it." />
    <meta name="twitter:description" content="Autopilot turns a plan into CI-gated PRs from worker agents in isolated worktrees, and one cockpit lets you watch and steer every coding agent." />
    <meta name="twitter:image" content="https://srjn45.github.io/warden/og-image.png" />
  </head>
  <body>
    <SiteHeader />
    <Hero />
    <ValueProps />
    <!-- Screenshots captured from an isolated demo instance (site/scripts/demo-seed.sh
         + site/tape/cockpit.tape); no real fleet, paths, or hostname. -->
    <Showcase side="left"  title="The TUI cockpit" img="cockpit.png"
      alt="The TUI cockpit with its control tree, terminal pane, and selected agent session."
      blurb="Framed panes, live agent detail, scrollable sessions, approvals inbox — all in the terminal." />
    <Showcase side="right" title="Web mission control" img="web-cockpit.png"
      alt="The web Cockpit home with fleet summary and agent cards grouped in the project tree."
      blurb="A URL-routed dashboard with a Cockpit home, live SSE fleet, project-tree grouping, and an attention queue — in the browser." />
    <Showcase side="left"  title="Fleet metrics & savings" img="web-metrics.png"
      alt="The web Metrics view with per-agent and fleet-wide CPU and memory charts."
      blurb="CPU, memory, context fill and fleet size per agent and fleet-wide — plus the tokens-saved trend and per-model cost, from the savings ledger." />
    <Showcase side="right" title="Autopilot at a glance" img="web-autopilot-run.png"
      alt="The web Autopilot modal showing one active plan, its task checklist, worker, integration base, and pause and stop controls."
      blurb="Inspect an active run's plan checklist, worker status, integration base, and daemon supervision without leaving mission control." />
    <Showcase side="left" title="Backend registry" img="web-backends.png"
      alt="The web Backends modal listing detected backends with installed state, tier, default choice, and enabled setting."
      blurb="Rescan the local backend registry and review each backend's installed state, tier, default selection, and enabled setting." />
    <FeatureGrid />
    <HowItWorks />
    <PipelineDiagram />
    <Trust />
    <Quickstart />
    <AndroidApp />
    <Blog />
    <SiteFooter />
  </body>
</html>
