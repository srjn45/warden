{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/workspace/personal/agentctl/hooks/warden-hook.sh SessionStart" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "~/workspace/personal/agentctl/hooks/warden-hook.sh Notification" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/workspace/personal/agentctl/hooks/warden-hook.sh Stop" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "~/workspace/personal/agentctl/hooks/warden-hook.sh SubagentStop" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/workspace/personal/agentctl/hooks/warden-hook.sh SessionEnd" } ] }
    ]
  }
}
