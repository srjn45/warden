#!/usr/bin/env bash
#
# Pre-push hook: run the same checks CI runs before allowing a push, so a
# gofmt/vet/test/build failure is caught locally instead of on the runner.
#
# Mirrors .github/workflows/ci.yml via `make verify`
# (gofmt -> go vet -> go tests -> web unit tests -> release build + smoke).
#
# Skip in a pinch with:  git push --no-verify
set -euo pipefail

# Run from the repo root regardless of where git invokes the hook.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running 'make verify' (CI parity)…"
if ! make verify; then
	echo
	echo "pre-push: checks failed — push aborted. Fix the above, or bypass with 'git push --no-verify'." >&2
	exit 1
fi
echo "pre-push: all checks passed."
