#!/usr/bin/env bash
#
# Pre-commit hook: run the fast formatting/vet gate before a commit is created,
# so a gofmt or `go vet` failure is caught here instead of at push time or on
# CI. Deliberately lightweight — no tests or build — to keep `git commit`
# snappy; the heavier `make verify-fast` (web + release build) runs at push
# time in .githooks/pre-push, and CI owns the full `go test ./...`.
#
# Runs `make fmt-check lint`: gofmt-clean check -> go vet.
#
# Skip in a pinch with:  git commit --no-verify
set -euo pipefail

# Run from the repo root regardless of where git invokes the hook.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: running 'make fmt-check lint' (gofmt/vet)…"
if ! make fmt-check lint; then
	echo
	echo "pre-commit: checks failed — commit aborted. Fix the above (try 'make fmt'), or bypass with 'git commit --no-verify'." >&2
	exit 1
fi
echo "pre-commit: all checks passed."
