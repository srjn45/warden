# warden web UI
web/node_modules/
web/.astro/
web/dist/*
!web/dist/.gitkeep

bin/
dist/
.claude/

# warden runtime state / worktrees (created when running agents from this checkout)
.agentctl/
# Ignore warden runtime state under .warden/, but keep the per-project check
# config tracked — it is meant to be committed so it is present in every worktree
# for `wd check` and the test-redirect hook.
.warden/*
!.warden/check.yml
.worktrees/

# stray subagent typo dir
.claire/

# brainstorming visual companion
.superpowers/

warden.code-workspace

dev.log

# coverage artifacts (make cover)
coverage.out